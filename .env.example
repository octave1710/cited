# CITED — copy to .env and fill in. The demo runs fully offline with the defaults below.

# Profound API (production visibility, bot crawls, citations, query fan-out, agents).
PROFOUND_API_KEY=your-profound-key
# Anthropic API (Query Lab live testing).
ANTHROPIC_API_KEY=your-anthropic-key

# mock = recorded fixtures, no network. real = live API calls.
LLM_MODE=mock
PROFOUND_MODE=mock

DATABASE_PATH=./data/cited.db
FIXTURES_DIR=./fixtures
