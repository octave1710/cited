# CITED — copy to .env and fill what you have. Nothing here is required to start the app;
# each missing key degrades one capability and the screen says which, rather than failing.

# Writes the ~160 buyer questions per category.
# Absent: only topics already recorded in fixtures/llm/recordings.json can run.
OPENAI_API_KEY=

# Five of the six answer engines, through apify/google-search-scraper:
# Google AI Overview, Google AI Mode, Perplexity, ChatGPT search, Gemini.
# Absent: the board replays fixtures/engines/vitamin-c-serum-uk.json and labels itself RECORDED.
APIFY_TOKEN=

# The sixth engine. Anthropic Messages API with the web_search tool, called at the source.
# Absent: the Claude column reads "not asked" instead of silently empty.
ANTHROPIC_API_KEY=

# Optional model overrides.
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# auto  = live when a key is present, replay when not. The default.
# mock  = always replay, refuses a prompt it has no recording for.
# real  = always live.
LLM_MODE=auto

# RECORD=0 stops new live answers being written to the recordings file.
RECORD=1

# Created automatically.
DATABASE_PATH=./data/cited.db
FIXTURES_DIR=./fixtures
